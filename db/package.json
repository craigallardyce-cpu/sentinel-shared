{
  "name": "@sentinel/db",
  "version": "0.1.0",
  "private": true,
  "description": "Shared database adapter contract for the Mariner Sentinel fleet — one interface over SQLite, Postgres, and (later) a non-native driver for Capacitor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
